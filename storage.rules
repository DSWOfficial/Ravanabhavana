rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'udarasampath@gmail.com';
    }

    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
