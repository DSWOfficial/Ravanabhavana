rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'udarasampath@gmail.com';
    }

    function publicContent() {
      return true;
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && request.resource.data.role == 'user';
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /videos/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /sessions/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /weeklySchedule/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /donationSettings/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /userVideoProgress/{id} {
      allow create, update: if isOwner(request.resource.data.userId)
        && !request.resource.data.keys().hasAny(['note']);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /userPrivateNotes/{id} {
      allow create, update: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /userSessionJoins/{id} {
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /donationSubmissions/{id} {
      allow create: if (signedIn() && request.resource.data.userId == request.auth.uid)
        || request.resource.data.isGuest == true;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /pages/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /navigation/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }

    match /media/{id} {
      allow read: if publicContent();
      allow write: if isAdmin();
    }
  }
}
